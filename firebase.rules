// Firestore Security Rules for AB TRADE
// Copy these rules to Firebase Console → Firestore → Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Products - Public read, admin write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Categories - Public read, admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders - Users can create, read own orders, admin can manage all
    match /orders/{orderId} {
      allow create: if isAuthenticated() && 
                       request.resource.data.customerId == request.auth.uid;
      allow read: if isAuthenticated() && 
                     (resource.data.customerId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false; // Orders cannot be deleted
    }

    // Users - User can read/write own profile, admin can read all
    match /users/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAuthenticated() && 
                     (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // Accounts cannot be deleted
    }

    // Admins - Only admins can access
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Admins managed manually
    }

    // Messages - Anyone can create, admin can read
    match /messages/{messageId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
